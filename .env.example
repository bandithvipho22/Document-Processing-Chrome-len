# OCR Application Configuration
# Copy this file to .env and customize for your environment

# ============================================================================
# Server Configuration
# ============================================================================
HOST=0.0.0.0
PORT=8000
RELOAD=false
WORKERS=4

# ============================================================================
# OCR Processing Configuration
# ============================================================================
# Language for OCR processing (BCP 47 codes)
# Supported: en (English), kh (Khmer), ja (Japanese), fr (French), es (Spanish), zh (Chinese)
OCR_LANGUAGE=en

# Maximum file size in MB
MAX_FILE_SIZE_MB=20

# OCR API timeout in seconds (5 minutes = 300 seconds)
API_TIMEOUT=300

# ============================================================================
# Chrome Lens API Configuration
# ============================================================================
# Maximum concurrent API requests (prevent rate limiting)
# Recommended: 5-15 (higher values risk IP bans)
CHROME_LENS_MAX_CONCURRENT=10

# Chrome Lens API timeout per request (seconds)
CHROME_LENS_TIMEOUT=60

# Maximum number of retries for failed requests
CHROME_LENS_RETRIES=3

# Delay between retries (seconds)
CHROME_LENS_RETRY_DELAY=2

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true

# Database (future)
DATABASE_URL=postgresql://user:password@localhost/ocr_db

# Redis Cache (future)
REDIS_URL=redis://localhost:6379/0

# File Storage (future)
STORAGE_TYPE=local  # local, s3, gcs, azure
AWS_BUCKET=ocr-files
AWS_REGION=us-east-1

# API Keys (if using external services)
GOOGLE_API_KEY=your_key_here
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_key_here

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_password

# Security
SECRET_KEY=your-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Monitoring
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
ENABLE_METRICS=true

# Feature Flags
ENABLE_BATCH_PROCESSING=false
ENABLE_WEBHOOKS=false
ENABLE_USER_ACCOUNTS=false
