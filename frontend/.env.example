# Frontend Configuration Example
# Copy to frontend/.env.local and customize

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# File Upload Configuration
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_MAX_FILENAME_LENGTH=255
NEXT_PUBLIC_ALLOWED_FORMATS=.png,.jpg,.jpeg,.pdf

# UI Configuration
NEXT_PUBLIC_THEME=light
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Feature Flags
NEXT_PUBLIC_ENABLE_BATCH_PROCESSING=false
NEXT_PUBLIC_ENABLE_HISTORY=false
NEXT_PUBLIC_ENABLE_SHARING=false

# Analytics (if needed)
NEXT_PUBLIC_GA_ID=your-ga-id
NEXT_PUBLIC_MIXPANEL_TOKEN=your-token

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn
